# Application (FASTAPI_ENV and FRONTEND_HOST also support host-side development)
FASTAPI_ENV=development
PROJECT_NAME=Grounded Research
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5178
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Initial administrator
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

# PostgreSQL (DATABASE_URL is used by host-side backend commands)
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:55439/grounded_research

# Chat model
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Embeddings
ZHIPUAI_API_KEY=your-zhipu-api-key
ZHIPUAI_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPUAI_EMBEDDING_MODEL=embedding-3

# Chroma storage inside the backend container
CHROMA_PERSIST_DIRECTORY=../.local/chroma

# Optional email configuration. The local override provides Mailpit.
# Use a real SMTP provider for deployment or leave host/from-address empty.
SMTP_HOST=mailpit
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com

# Optional monitoring
SENTRY_DSN=

# Optional research web search and public cache
TAVILY_API_KEY=
REDIS_URL=
# Host-side storage; setup-local.sh creates absolute paths in .env
DOCUMENT_STORAGE_DIR=../.local/documents
